module(
    name = "slang",
    bazel_compatibility = [">=9.0.0"],
    version = "10.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "1.8.1")
bazel_dep(name = "llvm", version = "0.6.0")

bazel_dep(name = "boost.unordered", version = "1.90.0.bcr.1")
bazel_dep(name = "catch2", version = "3.13.0")
bazel_dep(name = "cpptrace", version = "1.0.4.bcr.1")
bazel_dep(name = "fmt", version = "12.1.0")
bazel_dep(name = "mimalloc", version = "2.2.4.bcr.2")

single_version_override(module_name = "libunwind", version = "1.8.3")

git_override(
    module_name = "llvm",
    remote = "https://github.com/rrbutani/toolchains_llvm_bootstrapped.git",
    commit = "5f4ad9d5806cc03dc007c91475c94ad0647652b2",
)
git_override(
    module_name = "rules_cc",
    remote = "https://github.com/rrbutani/rules_cc.git",
    commit = "9184f2005b713ecefc50c9aac08563ad23305924",
)

#

bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
    commit = "7fe1eab26d2b8eeb5e1c6a2f38bddb001e3f9696",
)

##

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

EXPECTED_LITE_VERSION = "0.10.0"
http_archive(
    name = "expected-lite",
    url = "https://github.com/nonstd-lite/expected-lite/archive/refs/tags/v{}.tar.gz".format(EXPECTED_LITE_VERSION),
    integrity = "sha256-z+CC5P/t7u2sR3Y1BBAmRqOcCAWZx8H+mSmdah+Zr5I=",
    strip_prefix = "expected-lite-{}".format(EXPECTED_LITE_VERSION),
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_binary")

cc_library(
    name = "expected-lite",
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include", "include/nonstd"],
    visibility = ["//visibility:public"],
)
""")

BS_THREAD_POOL_VERSION = "5.1.0"
http_archive(
    name = "bs_thread_pool",
    url = "https://github.com/bshoshany/thread-pool/archive/refs/tags/v{}.tar.gz".format(BS_THREAD_POOL_VERSION),
    integrity = "sha256-VDePucvq7nKZbT+HYUacQ7t90tSwf67G0ppoJ3vZGlE=",
    strip_prefix = "thread-pool-{}".format(BS_THREAD_POOL_VERSION),
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_binary")

cc_library(
    name = "bs_thread_pool",
    hdrs = glob(["include/*.hpp"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
)
""")

##

flag_alias(name = "use_threads", starlark_flag = "//:use_threads")
flag_alias(name = "use_mimalloc", starlark_flag = "//:use_mimalloc")
flag_alias(name = "use_cpptrace", starlark_flag = "//:use_cpptrace")

##

register_toolchains(
    "@llvm//toolchain:all",
)
