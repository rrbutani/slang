bool_flag(
    name = "use_threads",
    build_setting_default = True,
    scope = "project",
)
config_setting(name = "use_threads_", flag_values = {":use_threads": "True"})

bool_flag(
    name = "use_mimalloc",
    build_setting_default = False, # TODO: broken; want just `@mimalloc//:mimalloc-lib`
    scope = "project",
)
config_setting(name = "use_mimalloc_", flag_values = {":use_mimalloc": "True"})

bool_flag(
    name = "use_cpptrace",
    build_setting_default = False, # TODO: broken; `libdwarf` uses `cc_test` w/o import
    scope = "project",
)
config_setting(name = "use_cpptrace_", flag_values = {":use_cpptrace": "True"})

#-------------------------------------------------------------------------------

## codegen

py_binary(
    name = "diagnostic_gen",
    srcs = [":scripts/diagnostic_gen.py"],
)
py_binary(
    name = "syntax_gen",
    srcs = [":scripts/syntax_gen.py"],
)

write_file(name = "path_marker1", out = "diag-", content = [])
write_file(name = "path_marker2", out = "syn-", content = [])

# NOTE: no `doCheck` so no `--srcDir`, no `--incDir`
diag_outs = [
    "diag-out/slang/diagnostics/AllDiags.h",
    "diag-out/slang/diagnostics/AnalysisDiags.h",
    "diag-out/slang/diagnostics/CompilationDiags.h",
    "diag-out/slang/diagnostics/ConstEvalDiags.h",
    "diag-out/slang/diagnostics/DeclarationsDiags.h",
    "diag-out/slang/diagnostics/ExpressionsDiags.h",
    "diag-out/slang/diagnostics/GeneralDiags.h",
    "diag-out/slang/diagnostics/LexerDiags.h",
    "diag-out/slang/diagnostics/LookupDiags.h",
    "diag-out/slang/diagnostics/MetaDiags.h",
    "diag-out/slang/diagnostics/NumericDiags.h",
    "diag-out/slang/diagnostics/ParserDiags.h",
    "diag-out/slang/diagnostics/PreprocessorDiags.h",
    "diag-out/slang/diagnostics/StatementsDiags.h",
    "diag-out/slang/diagnostics/SysFuncsDiags.h",
    "diag-out/slang/diagnostics/TypesDiags.h",
    "diag-out/DiagCode.cpp",
]
run_binary(
    name = "generate_diagnostics",
    outs = diag_outs,
    tool = ":diagnostic_gen",
    srcs = [
        ":scripts/diagnostics.txt",
        ":diag-", # HACK: see below
    ],
    args = [
        "--diagnostics", "$(location :scripts/diagnostics.txt)",
        # NOTE: we want `$(dirname $(location ...))
        #   - see: https://github.com/bazelbuild/bazel/pull/26236
        #   - `$(RULEDIR)` is expanded in `genrule`s but not location expansion
        #
        # instead we do an (awful) workaround:
        # "--outDir", "$(RULEDIR)/diag-out",
        "--outDir", "$(location :diag-)out/",
    ],
)

syntax_outs = [
    "syn-out/slang/syntax/AllSyntax.h",
    "syn-out/AllSyntax.cpp",
    "syn-out/SyntaxClone.cpp",
    "syn-out/slang/syntax/SyntaxKind.h",
    "syn-out/slang/syntax/SyntaxFwd.h",
    "syn-out/slang/syntax/CSTJsonVisitorGen.h",
    "syn-out/slang/parsing/TokenKind.h",
    "syn-out/slang/parsing/KnownSystemName.h",
    "syn-out/TokenKind.cpp",
    "syn-out/KnownSystemName.cpp",
]
run_binary(
    name = "generate_syntax",
    outs = syntax_outs,
    tool = ":syntax_gen",
    srcs = [
        ":scripts/syntax.txt",
        ":scripts/triviakinds.txt",
        ":scripts/tokenkinds.txt",
        ":scripts/systemnames.txt",
        ":syn-", # HACK: see below
    ],
    args = [
        "--syntax", "$(location :scripts/syntax.txt)",
        # NOTE: we want `$(dirname $(location ...))
        #   - see: https://github.com/bazelbuild/bazel/pull/26236
        #   - `$(RULEDIR)` is expanded in `genrule`s but not location expansion
        #
        # "--dir", "$(RULEDIR)/syn-out",
        "--dir", "$(location :syn-)out",
    ],
)

# slang_export.h
write_file(
    name = "generate_slang_export",
    out = "include/slang/slang_export.h",
    content = [
        '#pragma once',
        '#define SLANG_EXPORT',
    ],
)

v_maj, v_min, v_patch = module_version().split('.')[:3]
expand_template(
    name = "generate_version_info",
    template = ":source/util/VersionInfo.cpp.in",
    out = "VersionInfo.cpp",
    substitutions = {
        "@SLANG_VERSION_MAJOR@": v_maj,
        "@SLANG_VERSION_MINOR@": v_min,
        "@SLANG_VERSION_PATCH@": v_patch,
        "@SLANG_VERSION_HASH@": "null", # TODO: get from stamp file?
    },
)

#-------------------------------------------------------------------------------

## libraries

cc_library(
    name = "slang_lib",
    srcs = [
        ":VersionInfo.cpp",
    ] + diag_outs + syntax_outs + glob([
        "source/**/*.cpp",
        "source/**/*.h",
    ]),
    hdrs = [
        ":include/slang/slang_export.h",
    ] + glob([
        "include/**/*.h",
        "ext/ieee1800/*.h",
    ]),
    local_defines = select({
        ":use_threads_": ["SLANG_USE_THREADS"],
        "//conditions:default": [],
    }) + select({
        ":use_mimalloc_": ["SLANG_USE_MIMALLOC"],
        "//conditions:default": [],
    }) + select({
        ":use_cpptrace_": ["SLANG_USE_CPPTRACE"],
        "//conditions:default": [],
    }),
    deps = [
        "@fmt", "@boost.unordered", "@expected-lite", "@bs_thread_pool"
    ] + select({
        ":use_mimalloc_": ["@mimalloc"],
        "//conditions:default": [],
    }) + select({
        ":use_cpptrace_": ["@cpptrace"],
        "//conditions:default": [],
    }),
    copts = ["-std=c++20"],
    includes = ["include", "diag-out", "syn-out", "ext"],
    visibility = ["//visibility:public"],
)

#-------------------------------------------------------------------------------

## tools

cc_binary(
    name = "slang",
    srcs = [":tools/driver/slang_main.cpp"],
    copts = ["-std=c++20"],
    deps = [":slang_lib"],
    visibility = ["//visibility:public"],
)

